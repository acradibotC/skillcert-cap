<mvc:View
    controllerName="znxr09.hrupload.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:u="sap.ui.unified"
    xmlns:table="sap.ui.table"
    xmlns:layout="sap.ui.layout"
    xmlns:tnt="sap.tnt"
    xmlns:core="sap.ui.core"
    displayBlock="true"
    height="100%">

    <App id="app">
        <Page id="uploadPage" showHeader="false">
        <content>
            <tnt:ToolPage id="hrToolsPage" sideExpanded="{hrTools>/sideExpanded}" class="hrToolsShell">
                <tnt:sideContent>
                    <tnt:SideNavigation
                        id="hrToolsSideNavigation"
                        expanded="{hrTools>/sideExpanded}"
                        selectedKey="{hrTools>/selectedTab}"
                        itemSelect=".onHrSideNavSelect">
                        <tnt:item>
                            <tnt:NavigationList>
                                <tnt:NavigationListItem key="upload" text="{i18n>tabUploadTimesheet}" icon="sap-icon://upload"/>
                                <tnt:NavigationListItem key="profileApprovals" text="{i18n>tabProfileApprovals}" icon="sap-icon://approvals" visible="{user>/isHrAdmin}"/>
                            </tnt:NavigationList>
                        </tnt:item>
                        <tnt:fixedItem>
                            <tnt:NavigationList>
                                <tnt:NavigationListItem key="toggleNavigation" icon="sap-icon://menu2" tooltip="{i18n>tooltipToggleMenu}"/>
                            </tnt:NavigationList>
                        </tnt:fixedItem>
                    </tnt:SideNavigation>
                </tnt:sideContent>
                <tnt:mainContents>
                    <Page id="hrToolsMainPage" showHeader="false">
                        <content>
                            <VBox class="sapUiResponsiveMargin hrToolsMainContent">
                <VBox visible="{= ${hrTools>/selectedTab} === 'upload' }">
                <!-- Custom Modern Header -->
                <HBox alignItems="Center" class="timesheetPageHeader sapUiSmallMarginBottom">
                    <core:Icon src="sap-icon://upload" size="2rem" color="#fff" class="sapUiMediumMarginEnd" />
                    <Title text="{i18n>pageTitle}" class="timesheetHeaderTitle" level="H2" />
                </HBox>

                <!-- ============ Section 1: File Upload Zone ============ -->
                <Panel id="panelUpload" headerText="{i18n>panelUpload}" class="sapUiSmallMarginBottom">
                    <VBox class="sapUiSmallMargin">
                        <HBox alignItems="Center" justifyContent="Start" class="sapUiSmallMarginBottom">
                            <u:FileUploader id="fileUploader"
                                name="excelFile"
                                fileType="xlsx,xls,csv"
                                placeholder="{i18n>filePlaceholder}"
                                change=".onFileSelected"
                                width="400px"
                                buttonText="{i18n>btnBrowse}" />
                            <Button id="btnParse" text="{i18n>btnParseFile}" icon="sap-icon://accept"
                                type="Emphasized" press=".onParseFile" enabled="{uploadModel>/fileSelected}"
                                class="sapUiSmallMarginBegin" />
                            <Button id="btnClear" text="{i18n>btnClear}" icon="sap-icon://decline"
                                type="Transparent" press=".onClearFile"
                                class="sapUiSmallMarginBegin" />
                        </HBox>
                        <HBox id="fileInfoBox" visible="{uploadModel>/fileSelected}" alignItems="Center">
                            <core:Icon src="sap-icon://excel-attachment" size="1.25rem" color="#217346" class="sapUiTinyMarginEnd" />
                            <Text text="{uploadModel>/fileName}" class="sapUiTinyMarginEnd" />
                            <ObjectStatus text="{uploadModel>/fileSize}" state="Information" />
                        </HBox>
                    </VBox>
                </Panel>

                <!-- ============ Section 2: Data Preview ============ -->
                <Panel id="panelPreview" headerText="{i18n>panelPreview}" visible="{uploadModel>/dataParsed}" class="sapUiSmallMarginBottom">
                    <!-- Summary bar -->
                    <Toolbar>
                        <Title text="{i18n>previewTitle}" level="H4" />
                        <ToolbarSpacer />
                        <ObjectStatus text="{= ${uploadModel>/totalRows} + ' ' + ${i18n>lblRows}}" state="Success" icon="sap-icon://accept" />
                        <ObjectStatus text="{= ${uploadModel>/errorRows} + ' ' + ${i18n>lblErrors}}" state="Error" icon="sap-icon://alert"
                            visible="{= ${uploadModel>/errorRows} > 0}" class="sapUiSmallMarginBegin" />
                    </Toolbar>
                    <Table id="previewTable"
                        items="{uploadModel>/records}"
                        mode="MultiSelect"
                        growing="true"
                        growingThreshold="20"
                        class="sapUiSizeCompact">
                        <columns>
                            <Column hAlign="Center" width="5rem"><Text text="{i18n>colStatus}" /></Column>
                            <Column hAlign="Center" width="5rem"><Text text="{i18n>colRow}" /></Column>
                            <Column hAlign="Center" width="7rem"><Text text="{i18n>colPernr}" /></Column>
                            <Column hAlign="Center" width="7rem"><Text text="{i18n>colWorkDate}" /></Column>
                            <Column hAlign="Center" width="6rem"><Text text="{i18n>colFirstEntry}" /></Column>
                            <Column hAlign="Center" width="6rem"><Text text="{i18n>colLastExit}" /></Column>
                            <Column hAlign="Center" width="5rem"><Text text="{i18n>colIOT}" /></Column>
                            <Column hAlign="Center" width="5rem"><Text text="{i18n>colIOTwF}" /></Column>
                            <Column hAlign="Center" width="4rem"><Text text="{i18n>colIWA}" /></Column>
                            <Column hAlign="Center" width="4rem"><Text text="{i18n>colEntry}" /></Column>
                            <Column hAlign="Center" width="4rem"><Text text="{i18n>colExit}" /></Column>
                            <Column><Text text="{i18n>colErrorMsg}" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem vAlign="Middle" highlight="{= ${uploadModel>_hasError} ? 'Error' : 'None' }">
                                <cells>
                                    <core:Icon src="{= ${uploadModel>_hasError} ? 'sap-icon://error' : 'sap-icon://sys-enter-2'}"
                                        color="{= ${uploadModel>_hasError} ? '#bb0000' : '#2b7c2b'}" />
                                    <Text text="{uploadModel>_rowIndex}" />
                                    <Text text="{uploadModel>Pernr}" />
                                    <Text text="{uploadModel>WorkDateDisplay}" />
                                    <Text text="{uploadModel>FirstEntryDisplay}" />
                                    <Text text="{uploadModel>LastExitDisplay}" />
                                    <Text text="{uploadModel>Iot}" />
                                    <Text text="{uploadModel>Iotwf}" />
                                    <Text text="{uploadModel>Iwa}" />
                                    <Text text="{uploadModel>NumberOfEntry}" />
                                    <Text text="{uploadModel>NumberOfExit}" />
                                    <Text text="{uploadModel>_errorMsg}" class="errorText" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>

                <!-- ============ Section 3: Upload Controls ============ -->
                <Panel id="panelActions" headerText="{i18n>panelActions}" visible="{uploadModel>/dataParsed}">
                    <Toolbar>
                        <Button id="btnDeleteSelected" text="{i18n>btnDeleteSelected}" icon="sap-icon://delete"
                            type="Reject" press=".onDeleteSelected" class="sapUiTinyMarginEnd"
                            enabled="{= !${uploadModel>/uploading}}" />
                        <ToolbarSpacer />
                        <Button id="btnCheckExisting" text="{i18n>btnCheckExisting}" icon="sap-icon://inspect"
                            type="Default" press=".onCheckExisting" class="sapUiTinyMarginEnd"
                            enabled="{= ${uploadModel>/totalRows} > 0 &amp;&amp; ${uploadModel>/errorRows} === 0 &amp;&amp; !${uploadModel>/uploading}}" />
                        <Button id="btnUpload" text="{i18n>btnUploadToSAP}" icon="sap-icon://pending"
                            type="Emphasized" press=".onUploadToSAP"
                            enabled="{= ${uploadModel>/totalRows} > 0 &amp;&amp; ${uploadModel>/errorRows} === 0 &amp;&amp; !${uploadModel>/uploading}}" />
                    </Toolbar>
                    <!-- Progress -->
                    <VBox visible="{uploadModel>/uploading}" class="sapUiSmallMargin">
                        <ProgressIndicator id="uploadProgress"
                            percentValue="{uploadModel>/uploadProgress}"
                            displayValue="{uploadModel>/uploadProgressText}"
                            state="Information"
                            showValue="true" />
                    </VBox>
                </Panel>
                </VBox>

                <VBox visible="{= ${hrTools>/selectedTab} === 'profileApprovals' &amp;&amp; ${user>/isHrAdmin} }" class="sapUiResponsiveContentPadding">
                    <mvc:XMLView id="profileApprovalInboxView" viewName="znxr09.znxr09f300.view.ProfileApprovalInbox"/>
                </VBox>

                            </VBox>
                        </content>
                    </Page>
                </tnt:mainContents>
            </tnt:ToolPage>
        </content>
        </Page>
    </App>
</mvc:View>
