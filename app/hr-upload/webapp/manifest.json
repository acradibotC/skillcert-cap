{
    "_version": "1.58.0",
    "sap.app": {
        "id": "znxr09.hrupload",
        "type": "application",
        "title": "{{appTitle}}",
        "description": "{{appDescription}}",
        "applicationVersion": { "version": "1.0.0" },
        "dataSources": {
            "profileService": {
                "uri": "/api/profile/v1/",
                "type": "OData",
                "settings": {
                    "odataVersion": "4.0"
                }
            }
        }
    },
    "sap.ui5": {
        "rootView": {
            "viewName": "znxr09.hrupload.view.App",
            "type": "XML",
            "async": true,
            "id": "appView"
        },
        "dependencies": {
            "minUI5Version": "1.108.0",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.ui.layout": {},
                "sap.ui.table": {},
                "sap.tnt": {},
                "sap.ui.unified": {}
            }
        },
        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "znxr09.hrupload.i18n.i18n"
                }
            },
            "profileService": {
                "dataSource": "profileService",
                "preload": false,
                "settings": {
                    "synchronizationMode": "None",
                    "operationMode": "Server",
                    "autoExpandSelect": true,
                    "earlyRequests": false,
                    "groupId": "$auto",
                    "updateGroupId": "$direct"
                }
            }
        },
        "resources": { "css": [{ "uri": "css/style.css" }] }
    }
}
