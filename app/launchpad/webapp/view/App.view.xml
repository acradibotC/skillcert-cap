<mvc:View
    controllerName="znxr09.portal.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    
    <App id="app">
        <Page id="mainPage" showHeader="true" enableScrolling="false">
            <customHeader>
                <f:ShellBar
                    class="flpShellBar"
                    title="{user>/shellTitle}"
                    homeIcon="https://upload.wikimedia.org/wikipedia/commons/5/59/SAP_2011_logo.svg"
                    showCopilot="false"
                    showSearch="false"
                    showNotifications="{= ${user>/authorized} === true }"
                    notificationsNumber="{notification>/unreadCount}"
                    notificationsPressed=".onNotificationsPress"
                    showProductSwitcher="false"
                    homeIconPressed=".onNavToHome">
                    <f:profile>
                        <f:Avatar id="userAvatar" initials="{user>/initials}" press=".onAvatarPress" visible="{= ${user>/authorized} === true }" />
                    </f:profile>
                </f:ShellBar>
            </customHeader>
            <subHeader>
                <OverflowToolbar id="launchpadNavigation" class="flpNavigationBar" visible="{= ${user>/authorized} === true }">
                    <Button id="navHome" text="{i18n>navHome}" icon="sap-icon://home" type="Transparent" press=".onNavToHome" class="flpNavButton isActive"/>
                    <Button id="navTodos" text="{i18n>navTodos}" icon="sap-icon://task" type="Transparent" press=".onNavToTodos" class="flpNavButton"/>
                    <Button id="navEmployee" text="{i18n>navEmployeeServices}" icon="sap-icon://employee" type="Transparent" press=".onNavToEmployeeServices" class="flpNavButton"/>
                    <Button id="navTime" text="{i18n>navTimeManagement}" icon="sap-icon://timesheet" type="Transparent" press=".onNavToTimesheet" class="flpNavButton"/>
                    <Button id="navHr" text="{i18n>navHrTools}" icon="sap-icon://manager" type="Transparent" press=".onNavToHrTools" class="flpNavButton"/>
                    <ToolbarSpacer/>
                    <Text text="{user>/name}" class="flpNavUser"/>
                </OverflowToolbar>
            </subHeader>

            <content>
                <NavContainer id="navContainer" initialPage="loadingPage">
                    <!-- Loading Page -->
                    <Page id="loadingPage" showHeader="false">
                        <VBox alignItems="Center" justifyContent="Center" height="100%" class="sapUiLargeMarginTop">
                            <BusyIndicator size="2rem" />
                        </VBox>
                    </Page>

                    <!-- Home Page with Tiles -->
                    <Page id="homePage" showHeader="false" class="launchpadHomePage" enableScrolling="true">
                        <VBox id="homeContent" class="launchpadPageContent">
                            <!-- Welcome Banner -->
                            <HBox id="homeHero" class="welcomeBanner" justifyContent="SpaceBetween" alignItems="Center">
                                <VBox>
                                    <Text id="welcomeDate" text="Tuesday, June 16, 2026" class="welcomeDate"/>
                                    <Title id="welcomeGreeting" text="Hi Nguyen, great to see you!" level="H3" class="welcomeGreeting"/>
                                </VBox>
                            </HBox>

                            <!-- ========== To-Dos Section ========== -->
                            <VBox id="todoSection" class="launchpadSection">
                                <HBox justifyContent="SpaceBetween" alignItems="Center" class="launchpadSectionHeader">
                                    <HBox alignItems="Center">
                                        <Title text="{i18n>titleToDos}" level="H2" class="launchpadSectionTitle"/>
                                    </HBox>
                                    <Button id="btnRefreshTodos" text="{todo>/lastRefresh}" icon="sap-icon://refresh" type="Transparent" press=".onRefreshTodos"/>
                                </HBox>

                                <!-- Tabs: Tasks / Situations -->
                                <IconTabBar id="todoTabBar" selectedKey="tasks" class="todoTabBar">
                                    <items>
                                        <IconTabFilter key="tasks" text="{= ${i18n>tabTasks}.replace('{0}', ${todo>/taskCount}) }">
                                            <!-- Task Cards -->
                                            <HBox id="todoCardsContainer" wrap="Wrap" class="todoCardsContainer">
                                                <!-- Cards will be rendered dynamically by the controller -->
                                            </HBox>
                                            <VBox id="noTodosPlaceholder" visible="{= ${todo>/taskCount} === 0}" alignItems="Center" class="todoEmptyState">
                                                <core:Icon src="sap-icon://task" size="2.5rem" class="sapUiTinyMarginBottom"/>
                                                <Text text="{i18n>noPendingTasks}"/>
                                            </VBox>
                                        </IconTabFilter>
                                        <IconTabFilter key="situations" text="{i18n>tabSituations}">
                                            <VBox alignItems="Center" class="todoEmptyState">
                                                <core:Icon src="sap-icon://alert" size="2.5rem" class="sapUiTinyMarginBottom"/>
                                                <Text text="{i18n>noSituations}"/>
                                            </VBox>
                                        </IconTabFilter>
                                    </items>
                                </IconTabBar>
                            </VBox>

                            <!-- ========== My Home Section ========== -->
                            <VBox id="homeTilesSection" class="launchpadSection">
                                <Title text="{i18n>titleMyHome}" level="H2" class="launchpadSectionTitle"/>
                                <HBox wrap="Wrap" class="launchpadTileGrid">
                                    <GenericTile 
                                        class="tileLayout" 
                                        header="{i18n>tileMyProfile}" 
                                        subheader="{i18n>tileSkillsCerts}" 
                                        press=".onNavToProfile">
                                        <TileContent>
                                            <ImageContent src="sap-icon://employee" />
                                        </TileContent>
                                    </GenericTile>

                                    <GenericTile 
                                        class="tileLayout" 
                                        header="{i18n>tileMyTimesheet}" 
                                        subheader="{i18n>tileLogHours}" 
                                        press=".onNavToTimesheet">
                                        <TileContent>
                                            <ImageContent src="sap-icon://timesheet" />
                                        </TileContent>
                                    </GenericTile>
                                </HBox>
                            </VBox>

                            <!-- ========== HR Tools Section (visible for managers) ========== -->
                            <VBox id="hrSection" visible="true" class="launchpadSection"> <!-- TODO: restore {= ${user>/isManager} === true} after testing -->
                                <Title text="{i18n>sectionHrTools}" level="H2" class="launchpadSectionTitle"/>
                                <HBox wrap="Wrap" class="launchpadTileGrid">
                                    <GenericTile 
                                        class="tileLayout" 
                                        header="{i18n>tileHrUpload}" 
                                        subheader="{i18n>tileHrUploadSub}" 
                                        press=".onNavToHrUpload">
                                        <TileContent>
                                            <ImageContent src="sap-icon://upload-to-cloud" />
                                        </TileContent>
                                    </GenericTile>
                                </HBox>
                            </VBox>
                        </VBox>
                    </Page>

                    <!-- Error Page: Access Denied (unmapped email) -->
                    <Page id="errorPage" showHeader="false" class="sapUiContentPadding errorPageBg" enableScrolling="true">
                        <VBox alignItems="Center" justifyContent="Center" class="errorPageContent">
                            <core:Icon src="sap-icon://sys-help-2" size="5rem" color="#e78c07" class="sapUiMediumMarginBottom errorIcon"/>
                            <Title text="Something Went Wrong..." level="H1" class="sapUiSmallMarginBottom errorTitle"/>
                            <Text id="errorMessage" text="Your email is not linked to any employee record." 
                                  class="sapUiSmallMarginBottom errorDesc" textAlign="Center" wrapping="true"/>
                            <Text text="Please contact your administrator to register your email in the system." 
                                  class="sapUiTinyMarginBottom" textAlign="Center"/>
                            <HBox alignItems="Center" class="sapUiSmallMarginTop">
                                <core:Icon src="sap-icon://email" size="1rem" color="#0854A0" class="sapUiTinyMarginEnd"/>
                                <Link text="sso@nexora.com" href="mailto:sso@nexora.com" class="errorAdminLink"/>
                            </HBox>
                            <HBox class="sapUiLargeMarginTop" justifyContent="Center">
                                <Button text="Try Again" type="Emphasized" press=".onRetryAuth" icon="sap-icon://refresh" class="sapUiSmallMarginEnd"/>
                                <Button text="Sign Out" type="Transparent" press=".onLogout" icon="sap-icon://log"/>
                            </HBox>
                        </VBox>
                    </Page>
                </NavContainer>
            </content>
        </Page>
    </App>
</mvc:View>
