<mvc:View
    controllerName="znxr09.portal.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    
    <App id="app">
        <Page id="mainPage" showHeader="false" enableScrolling="false" class="flpMainPage">
            <content>
                <VBox id="flpRoot" class="flpRoot">
                    <OverflowToolbar id="systemStrip" class="flpSystemStrip" visible="{= ${user>/authorized} === true }">
                        <ToolbarSpacer/>
                        <core:Icon src="sap-icon://syntax" size="1rem" class="flpSystemIcon"/>
                        <Text text="{i18n>systemMode}" class="flpSystemText"/>
                        <Text text="{i18n>systemClient}" class="flpSystemText flpSystemClient"/>
                        <ToolbarSpacer/>
                    </OverflowToolbar>

                    <OverflowToolbar id="shellHeader" class="flpShellHeader" visible="{= ${user>/authorized} === true }">
                        <Button id="btnMenu" icon="sap-icon://menu2" type="Transparent" class="flpShellIconButton"/>
                        <Image id="sapLogo" src="https://upload.wikimedia.org/wikipedia/commons/5/59/SAP_2011_logo.svg" press=".onNavToHome" decorative="false" class="flpSapLogo"/>
                        <Title text="{user>/shellTitle}" level="H2" class="flpProductTitle"/>
                        <ToolbarSeparator class="flpShellSeparator"/>
                        <Button text="{i18n>navHome}" icon="sap-icon://slim-arrow-down" iconFirst="false" type="Transparent" press=".onNavToHome" class="flpHomeSelector"/>
                        <ToolbarSpacer/>
                        <Button id="notificationButton" icon="sap-icon://bell" type="Transparent" visible="{= ${user>/authorized} === true }" press=".onNotificationsPress" class="flpShellIconButton">
                            <customData>
                                <core:CustomData key="badge" value="{notification>/unreadCount}" writeToDom="true"/>
                            </customData>
                        </Button>
                        <f:Avatar id="userAvatar" initials="{user>/initials}" press=".onAvatarPress" visible="{= ${user>/authorized} === true }" class="flpProfileAvatar"/>
                    </OverflowToolbar>

                    <OverflowToolbar id="launchpadNavigation" class="flpNavigationBar" visible="{= ${user>/authorized} === true &amp;&amp; ${user>/isHomeContext} === true }">
                        <Button id="navHome" text="{i18n>navHome}" type="Transparent" press=".onNavToHome" class="flpNavButton isActive"/>
                        <ToolbarSeparator/>
                        <Button id="navTodos" text="{i18n>navTodos}" type="Transparent" press=".onNavToTodos" class="flpNavButton"/>
                        <Button id="navEmployee" text="{i18n>navEmployeeServices}" type="Transparent" press=".onNavToEmployeeServices" class="flpNavButton"/>
                        <Button id="navTime" text="{i18n>navTimeManagement}" type="Transparent" press=".onNavToTimesheet" class="flpNavButton"/>
                        <Button id="navHr" text="{i18n>navHrTools}" type="Transparent" press=".onNavToHrTools" class="flpNavButton"/>
                        <ToolbarSpacer/>
                    </OverflowToolbar>

                    <NavContainer id="navContainer" initialPage="loadingPage" class="flpContentNav">
                        <layoutData>
                            <FlexItemData growFactor="1" baseSize="0"/>
                        </layoutData>
                    <!-- Loading Page -->
                    <Page id="loadingPage" showHeader="false">
                        <VBox alignItems="Center" justifyContent="Center" height="100%" class="sapUiLargeMarginTop">
                            <BusyIndicator size="2rem" />
                        </VBox>
                    </Page>

                    <!-- Home Page with Tiles -->
                    <Page id="homePage" showHeader="false" class="launchpadHomePage" enableScrolling="true">
                        <VBox id="homeContent" class="launchpadPageContent">
                            <!-- Welcome Banner -->
                            <HBox id="homeHero" class="welcomeBanner" justifyContent="SpaceBetween" alignItems="Center">
                                <VBox>
                                    <Text id="welcomeDate" text="Tuesday, June 16, 2026" class="welcomeDate"/>
                                    <Title id="welcomeGreeting" text="Hi Nguyen, great to see you!" level="H3" class="welcomeGreeting"/>
                                </VBox>
                            </HBox>

                            <!-- ========== To-Dos Section ========== -->
                            <VBox id="todoSection" class="launchpadSection">
                                <HBox justifyContent="SpaceBetween" alignItems="Center" class="launchpadSectionHeader">
                                    <HBox alignItems="Center">
                                        <Title text="{i18n>titleToDos}" level="H2" class="launchpadSectionTitle"/>
                                        <Button
                                            icon="{= ${user>/sections/todosExpanded} ? 'sap-icon://slim-arrow-down' : 'sap-icon://slim-arrow-right' }"
                                            type="Transparent"
                                            tooltip="{i18n>tooltipToggleSection}"
                                            press=".onToggleHomeSection"
                                            class="launchpadSectionToggle">
                                            <customData>
                                                <core:CustomData key="section" value="todosExpanded"/>
                                            </customData>
                                        </Button>
                                    </HBox>
                                    <Button id="btnRefreshTodos" text="{todo>/lastRefresh}" icon="sap-icon://refresh" type="Transparent" press=".onRefreshTodos"/>
                                </HBox>

                                <!-- Tabs: Tasks / Situations -->
                                <IconTabBar id="todoTabBar" selectedKey="tasks" class="todoTabBar" visible="{user>/sections/todosExpanded}">
                                    <items>
                                        <IconTabFilter key="tasks" text="{= ${i18n>tabTasks}.replace('{0}', ${todo>/taskCount}) }">
                                            <!-- Task Cards -->
                                            <HBox id="todoCardsContainer" wrap="Wrap" class="todoCardsContainer">
                                                <!-- Cards will be rendered dynamically by the controller -->
                                            </HBox>
                                            <VBox id="noTodosPlaceholder" visible="{= ${todo>/taskCount} === 0}" alignItems="Center" class="todoEmptyState">
                                                <core:Icon src="sap-icon://task" size="2.5rem" class="sapUiTinyMarginBottom"/>
                                                <Text text="{i18n>noPendingTasks}"/>
                                            </VBox>
                                        </IconTabFilter>
                                        <IconTabFilter key="situations" text="{i18n>tabSituations}">
                                            <VBox alignItems="Center" class="todoEmptyState">
                                                <core:Icon src="sap-icon://alert" size="2.5rem" class="sapUiTinyMarginBottom"/>
                                                <Text text="{i18n>noSituations}"/>
                                            </VBox>
                                        </IconTabFilter>
                                    </items>
                                </IconTabBar>
                            </VBox>

                            <!-- ========== News + Pages Section ========== -->
                            <HBox id="homeTilesSection" wrap="Wrap" class="launchpadWorkArea">
                                <VBox id="newsSection" class="launchpadNewsColumn">
                                    <HBox alignItems="Center" class="launchpadSectionHeader">
                                        <Title text="{i18n>titleNews}" level="H2" class="launchpadSectionTitle"/>
                                        <Button
                                            icon="{= ${user>/sections/newsExpanded} ? 'sap-icon://slim-arrow-down' : 'sap-icon://slim-arrow-right' }"
                                            type="Transparent"
                                            tooltip="{i18n>tooltipToggleSection}"
                                            press=".onToggleHomeSection"
                                            class="launchpadSectionToggle">
                                            <customData>
                                                <core:CustomData key="section" value="newsExpanded"/>
                                            </customData>
                                        </Button>
                                    </HBox>
                                    <VBox class="newsCard" visible="{user>/sections/newsExpanded}">
                                        <VBox class="newsCardImage"/>
                                        <VBox class="newsCardBody">
                                            <Title text="{i18n>newsNoUpdateTitle}" level="H5" class="newsCardTitle"/>
                                            <Text text="{i18n>newsNoUpdateText}" class="newsCardText"/>
                                        </VBox>
                                    </VBox>
                                </VBox>

                                <VBox id="pagesSection" class="launchpadPagesColumn">
                                    <HBox alignItems="Center" class="launchpadSectionHeader">
                                        <Title text="{i18n>titlePages}" level="H2" class="launchpadSectionTitle"/>
                                        <Button
                                            icon="{= ${user>/sections/pagesExpanded} ? 'sap-icon://slim-arrow-down' : 'sap-icon://slim-arrow-right' }"
                                            type="Transparent"
                                            tooltip="{i18n>tooltipToggleSection}"
                                            press=".onToggleHomeSection"
                                            class="launchpadSectionToggle">
                                            <customData>
                                                <core:CustomData key="section" value="pagesExpanded"/>
                                            </customData>
                                        </Button>
                                    </HBox>
                                    <HBox wrap="Wrap" class="launchpadTileGrid" visible="{user>/sections/pagesExpanded}">
                                        <GenericTile
                                            class="tileLayout tileAccentBlue"
                                            header="{i18n>tileMyProfile}"
                                            subheader="{i18n>tileSkillsCerts}"
                                            press=".onNavToProfile">
                                            <TileContent>
                                                <ImageContent src="sap-icon://employee" />
                                            </TileContent>
                                        </GenericTile>

                                        <GenericTile
                                            class="tileLayout tileAccentTeal"
                                            header="{i18n>tileMyTimesheet}"
                                            subheader="{i18n>tileLogHours}"
                                            press=".onNavToTimesheet">
                                            <TileContent>
                                                <ImageContent src="sap-icon://timesheet" />
                                            </TileContent>
                                        </GenericTile>

                                        <GenericTile
                                            class="tileLayout tileAccentGreen"
                                            header="{i18n>tileHrUpload}"
                                            subheader="{i18n>tileHrUploadSub}"
                                            press=".onNavToHrUpload">
                                            <TileContent>
                                                <ImageContent src="sap-icon://upload-to-cloud" />
                                            </TileContent>
                                        </GenericTile>
                                    </HBox>
                                </VBox>
                            </HBox>
                        </VBox>
                    </Page>

                    <!-- Error Page: Access Denied (unmapped email) -->
                    <Page id="errorPage" showHeader="false" class="sapUiContentPadding errorPageBg" enableScrolling="true">
                        <VBox alignItems="Center" justifyContent="Center" class="errorPageContent">
                            <core:Icon src="sap-icon://sys-help-2" size="5rem" color="#e78c07" class="sapUiMediumMarginBottom errorIcon"/>
                            <Title text="Something Went Wrong..." level="H1" class="sapUiSmallMarginBottom errorTitle"/>
                            <Text id="errorMessage" text="Your email is not linked to any employee record." 
                                  class="sapUiSmallMarginBottom errorDesc" textAlign="Center" wrapping="true"/>
                            <Text text="Please contact your administrator to register your email in the system." 
                                  class="sapUiTinyMarginBottom" textAlign="Center"/>
                            <HBox alignItems="Center" class="sapUiSmallMarginTop">
                                <core:Icon src="sap-icon://email" size="1rem" color="#0854A0" class="sapUiTinyMarginEnd"/>
                                <Link text="sso@nexora.com" href="mailto:sso@nexora.com" class="errorAdminLink"/>
                            </HBox>
                            <HBox class="sapUiLargeMarginTop" justifyContent="Center">
                                <Button text="Try Again" type="Emphasized" press=".onRetryAuth" icon="sap-icon://refresh" class="sapUiSmallMarginEnd"/>
                                <Button text="Sign Out" type="Transparent" press=".onLogout" icon="sap-icon://log"/>
                            </HBox>
                        </VBox>
                    </Page>
                    </NavContainer>
                </VBox>
            </content>
        </Page>
    </App>
</mvc:View>
