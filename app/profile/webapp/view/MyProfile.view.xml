<mvc:View
    controllerName="znxr09.znxr09f300.controller.MyProfile"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form">

    <VBox busy="{profileUi>/busy}" busyIndicatorDelay="0" width="100%" class="profilePageSurface">
        <MessageStrip
            visible="{= ${profileUi>/errorKey} ? true : false }"
            text="{path:'profileUi>/errorKey', formatter:'.profileErrorText'}"
            type="Error"
            showIcon="true"
            showCloseButton="false"
            class="sapUiSmallMarginBottom"/>
        <Button
            visible="{= ${profileUi>/errorKey} ? true : false }"
            text="{i18n>profileRetry}"
            icon="sap-icon://refresh"
            press="onRefreshProfile"
            class="sapUiSmallMarginBottom"/>

        <VBox visible="{profileUi>/hasData}" width="100%">
            <VBox alignItems="Center" class="profileHeroContainer">
                <f:Avatar
                    initials="{profile>/Initials}"
                    displaySize="XL"
                    displayShape="Circle"
                    tooltip="{profile>/EmployeeName}"
                    class="profileAvatar"/>
                <Title text="{profile>/EmployeeName}" level="H1" class="profileHeroTitle sapUiTinyMarginTop"/>
                <Text
                    text="{profile>/HeroMeta}"
                    textAlign="Center"
                    wrapping="true"
                    class="profileHeroSubText sapUiTinyMarginTop"/>
            </VBox>

            <IconTabBar
                id="profileCoreTabs"
                expandable="false"
                applyContentPadding="false"
                headerMode="Inline"
                class="profileCoreTabs"
                selectedKey="personal">
                <items>
                    <IconTabFilter key="personal" text="{i18n>profileTabPersonal}">
                        <HBox wrap="Wrap" alignItems="Start" class="profileInfoGrid">
                            <VBox class="profileInfoCard">
                                <Title text="{i18n>profilePersonalInformation}" level="H3" class="profileSectionTitle"/>
                                <form:SimpleForm editable="false" layout="ResponsiveGridLayout" columnsXL="1" columnsL="1" columnsM="1" labelSpanXL="12" labelSpanL="12" labelSpanM="12" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0">
                                    <Label text="{i18n>profileEmployeeId}" labelFor="profileEmployeeIdInput"/>
                                    <Input id="profileEmployeeIdInput" value="{path:'profile>/Pernr', formatter:'.formatter.displayValue'}" editable="false" width="100%" class="profileReadOnlyInput"/>
                                    <Label text="{i18n>profileFullName}" labelFor="profileFullNameInput"/>
                                    <Input id="profileFullNameInput" value="{path:'profile>/EmployeeName', formatter:'.formatter.displayValue'}" editable="false" width="100%" class="profileReadOnlyInput"/>
                                    <Label text="{i18n>profileDateOfBirth}" labelFor="profileBirthDateInput"/>
                                    <Input id="profileBirthDateInput" value="{path:'profile>/DateOfBirth', formatter:'.formatter.formatDate'}" editable="false" width="100%" class="profileReadOnlyInput"/>
                                    <Label text="{i18n>profileGender}" labelFor="profileGenderInput"/>
                                    <Input id="profileGenderInput" value="{path:'profile>/Gender', formatter:'.formatter.displayValue'}" editable="false" width="100%" class="profileReadOnlyInput"/>
                                    <Label text="{i18n>profileNationality}" labelFor="profileNationalityInput"/>
                                    <Input id="profileNationalityInput" value="{path:'profile>/Nationality', formatter:'.formatter.displayValue'}" editable="false" width="100%" class="profileReadOnlyInput"/>
                                    <Label text="{i18n>profileMaritalStatus}" labelFor="profileMaritalStatusInput"/>
                                    <Input id="profileMaritalStatusInput" value="{path:'profile>/MaritalStatus', formatter:'.formatter.displayValue'}" editable="false" width="100%" class="profileReadOnlyInput"/>
                                    <Label text="{i18n>profileIdNumber}" labelFor="profileDisplayIdNumberInput"/>
                                    <Input id="profileDisplayIdNumberInput" value="{path:'profile>/IdNumber', formatter:'.formatter.displayValue'}" editable="false" width="100%" class="profileReadOnlyInput"/>
                                </form:SimpleForm>
                            </VBox>

                            <VBox class="profileInfoCard profileContactCard">
                                <Title text="{i18n>profileContactPaymentInformation}" level="H3" class="profileSectionTitle"/>
                                <form:SimpleForm editable="false" layout="ResponsiveGridLayout" columnsXL="1" columnsL="1" columnsM="1" labelSpanXL="12" labelSpanL="12" labelSpanM="12" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0">
                                    <Label text="{i18n>profileMobilePhone}" labelFor="profileDisplayTelephoneInput"/>
                                    <Input id="profileDisplayTelephoneInput" value="{path:'profile>/Telephone', formatter:'.formatter.displayValue'}" editable="false" width="100%" class="profileReadOnlyInput"/>
                                    <Label text="{i18n>profileWorkEmail}" labelFor="profileDisplayWorkEmailInput"/>
                                    <Input id="profileDisplayWorkEmailInput" value="{path:'profile>/WorkEmail', formatter:'.formatter.displayValue'}" editable="false" width="100%" class="profileReadOnlyInput profileSapInput"/>
                                    <Label text="{i18n>profileCurrentAddress}" labelFor="profileDisplayCurrentAddressInput"/>
                                    <Input id="profileDisplayCurrentAddressInput" value="{path:'profile>/CurrentAddress', formatter:'.formatter.displayValue'}" editable="false" width="100%" class="profileReadOnlyInput"/>
                                    <Label text="{i18n>profileTaxCode}" labelFor="profileDisplayTaxCodeInput"/>
                                    <Input id="profileDisplayTaxCodeInput" value="{path:'profile>/TaxCode', formatter:'.formatter.displayValue'}" editable="false" width="100%" class="profileReadOnlyInput"/>
                                    <Label text="{i18n>profilePaymentMethod}"/>
                                    <HBox wrap="Wrap" alignItems="Center" class="profilePaymentChoice">
                                        <RadioButton text="{i18n>profilePaymentCash}" selected="{profile>/IsCashPayment}" enabled="false" groupName="profilePaymentDisplay"/>
                                        <RadioButton text="{i18n>profilePaymentBankTransfer}" selected="{profile>/HasBankTransfer}" enabled="false" groupName="profilePaymentDisplay" class="sapUiMediumMarginBegin"/>
                                        <Text visible="{= !${profile>/IsCashPayment} &amp;&amp; !${profile>/HasBankTransfer} }" text="—"/>
                                    </HBox>
                                    <Label visible="{profile>/HasBankTransfer}" text="{i18n>profileBankAccount}" labelFor="profileDisplayBankAccountInput"/>
                                    <Input visible="{profile>/HasBankTransfer}" id="profileDisplayBankAccountInput" value="{path:'profile>/BankAccount', formatter:'.formatter.maskBankAccount'}" editable="false" width="100%" class="profileReadOnlyInput"/>
                                    <Label visible="{profile>/HasBankTransfer}" text="{i18n>profileBankName}" labelFor="profileBankNameInput"/>
                                    <Input visible="{profile>/HasBankTransfer}" id="profileBankNameInput" value="{path:'profile>/BankName', formatter:'.formatter.displayValue'}" editable="false" width="100%" class="profileReadOnlyInput"/>
                                </form:SimpleForm>
                                <Text visible="{= !${profile>/HasBankTransfer} }" text="{i18n>profileNoBankDetails}" wrapping="true" class="profileFieldHint"/>
                            </VBox>
                        </HBox>
                        <HBox justifyContent="End" alignItems="Center" wrap="Wrap" class="profileEditRow">
                            <Button id="profilePreviewEditButton" text="{i18n>profileEditButton}" icon="sap-icon://edit" type="Emphasized" enabled="{profileUi>/hasEditableField}" tooltip="{i18n>profileEditTooltip}" press="onEditProfile"/>
                        </HBox>
                        <MessageStrip
                            visible="{profileUi>/hasPendingRequest}"
                            text="{i18n>profilePendingRequestNotice}"
                            type="Warning"
                            showIcon="true"
                            class="sapUiSmallMarginTop"/>
                        <VBox class="profileSingleCard sapUiMediumMarginTop">
                            <OverflowToolbar class="premiumTableHeader">
                                <Title text="{i18n>profileRequestHistory}" level="H3"/>
                                <ToolbarSpacer/>
                                <Button icon="sap-icon://refresh" type="Transparent" tooltip="{i18n>profileRefreshHistory}" press="onRefreshProfile"/>
                            </OverflowToolbar>
                            <Table
                                id="profileRequestHistoryTable"
                                items="{profileRequests>/rows}"
                                growing="true"
                                growingThreshold="5"
                                noDataText="{i18n>profileNoRequests}"
                                alternateRowColors="true">
                                <columns>
                                    <Column><Text text="{i18n>profileRequestNo}"/></Column>
                                    <Column demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>profileSubmittedAt}"/></Column>
                                    <Column demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>profileRemark}"/></Column>
                                    <Column hAlign="End"><Text text="{i18n>profileStatus}"/></Column>
                                    <Column hAlign="End"><Text text="{i18n>colAction}"/></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <ObjectIdentifier title="{profileRequests>RequestNo}" text="{profileRequests>ID}"/>
                                            <Text text="{path:'profileRequests>SubmittedAt', formatter:'.formatter.formatDateTime'}"/>
                                            <Text text="{profileRequests>Remark}" wrapping="true"/>
                                            <ObjectStatus text="{profileRequests>StatusText}" icon="{path:'profileRequests>Status', formatter:'.formatter.statusIcon'}" state="{path:'profileRequests>Status', formatter:'.formatter.statusState'}" inverted="true"/>
                                            <Button text="{i18n>profileResubmitButton}" type="Transparent" visible="{= ${profileRequests>Status} === '04' }" press="onReviseProfileRequest"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
                    </IconTabFilter>

                    <IconTabFilter key="contactPayment" text="{i18n>profileTabContactPayment}">
                        <VBox class="profileSingleCard">
                            <Title text="{i18n>profileContactPaymentInformation}" level="H3" class="profileSectionTitle"/>
                            <form:SimpleForm editable="false" layout="ResponsiveGridLayout" columnsXL="2" columnsL="2" columnsM="1" labelSpanXL="4" labelSpanL="4" labelSpanM="4">
                                <Label text="{i18n>profileMobilePhone}"/><Text text="{path:'profile>/Telephone', formatter:'.formatter.displayValue'}"/>
                                <Label text="{i18n>profileWorkEmail}"/><Text text="{path:'profile>/WorkEmail', formatter:'.formatter.displayValue'}"/>
                                <Label text="{i18n>profilePermanentAddress}"/><Text text="{path:'profile>/PermanentAddress', formatter:'.formatter.displayValue'}" wrapping="true"/>
                                <Label text="{i18n>profileCurrentAddress}"/><Text text="{path:'profile>/CurrentAddress', formatter:'.formatter.displayValue'}" wrapping="true"/>
                                <Label text="{i18n>profileTaxCode}"/><Text text="{path:'profile>/TaxCode', formatter:'.formatter.displayValue'}"/>
                                <Label text="{i18n>profilePaymentMethod}"/><Text text="{path:'profile>/PaymentMethodDisplay', formatter:'.formatter.displayValue'}"/>
                                <Label visible="{profile>/HasBankTransfer}" text="{i18n>profileBankName}"/><Text visible="{profile>/HasBankTransfer}" text="{path:'profile>/BankName', formatter:'.formatter.displayValue'}"/>
                                <Label visible="{profile>/HasBankTransfer}" text="{i18n>profileBankAccount}"/><Text visible="{profile>/HasBankTransfer}" text="{path:'profile>/BankAccount', formatter:'.formatter.maskBankAccount'}"/>
                            </form:SimpleForm>
                        </VBox>
                    </IconTabFilter>

                    <IconTabFilter key="work" text="{i18n>profileTabWork}">
                        <VBox class="profileSingleCard">
                            <Title text="{i18n>profileWorkInformation}" level="H3" class="profileSectionTitle"/>
                            <form:SimpleForm editable="false" layout="ResponsiveGridLayout" columnsXL="2" columnsL="2" columnsM="1" labelSpanXL="4" labelSpanL="4" labelSpanM="4">
                                <Label text="{i18n>profilePosition}"/><Text text="{path:'profile>/PositionName', formatter:'.formatter.displayValue'}"/>
                                <Label text="{i18n>profileOrgUnit}"/><Text text="{path:'profile>/OrgUnitName', formatter:'.formatter.displayValue'}"/>
                                <Label text="{i18n>profileJoinDate}"/><Text text="{path:'profile>/JoinDate', formatter:'.formatter.formatDate'}"/>
                            </form:SimpleForm>
                        </VBox>
                    </IconTabFilter>

                    <IconTabFilter key="contract" text="{i18n>profileTabContract}">
                        <VBox class="profileSingleCard">
                            <Title text="{i18n>profileContractInformation}" level="H3" class="profileSectionTitle"/>
                            <Label text="{i18n>profileTabContract}"/><Text text="{path:'profile>/ContractType', formatter:'.formatter.displayValue'}" class="sapUiTinyMarginBottom"/>
                            <MessageStrip text="{i18n>profileContractUnavailable}" type="Information" showIcon="true"/>
                        </VBox>
                    </IconTabFilter>

                    <IconTabFilter key="dependents" text="{i18n>profileTabDependents}">
                        <VBox class="profileSingleCard">
                            <Title text="{i18n>profileDependentsInformation}" level="H3" class="profileSectionTitle"/>
                            <Text text="{path:'profile>/DependentsSummary', formatter:'.formatter.displayValue'}" wrapping="true" class="sapUiTinyMarginBottom"/>
                            <MessageStrip text="{i18n>profileDependentsViewOnly}" type="Information" showIcon="true"/>
                        </VBox>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </VBox>
    </VBox>
</mvc:View>
