<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">
    <Dialog
        id="profileEditDialog"
        title="{= ${profileEdit>/isRevision} ? ${i18n>profileReviseTitle} : ${i18n>profileEditTitle} }"
        contentWidth="68rem"
        stretchOnPhone="true"
        draggable="true"
        resizable="true"
        busy="{profileEdit>/busy}"
        busyIndicatorDelay="0"
        afterOpen="onProfileDialogAfterOpen"
        afterClose="onProfileDialogAfterClose">
        <content>
            <VBox class="sapUiResponsiveContentPadding">
                <MessageStrip
                    text="{i18n>profileEditPreviewNotice}"
                    type="Warning"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"/>

                <form:SimpleForm
                    editable="true"
                    layout="ResponsiveGridLayout"
                    columnsXL="2"
                    columnsL="2"
                    columnsM="1"
                    labelSpanXL="4"
                    labelSpanL="4"
                    labelSpanM="4"
                    emptySpanXL="0"
                    emptySpanL="0"
                    emptySpanM="0">

                    <Label text="{i18n>profileIdNumber}" labelFor="profileIdNumberInput"/>
                    <Input id="profileIdNumberInput" value="{profileEdit>/values/ID_NUMBER}" enabled="{profileEdit>/states/ID_NUMBER/EffectiveEditable}" maxLength="20" change="onProfileFieldChange"/>

                    <Label text="{i18n>profileTelephone}" labelFor="profileTelephoneInput"/>
                    <Input id="profileTelephoneInput" value="{profileEdit>/values/TELEPHONE}" enabled="{profileEdit>/states/TELEPHONE/EffectiveEditable}" maxLength="30" type="Tel" change="onProfileFieldChange"/>

                    <Label text="{i18n>profileWorkEmail}" labelFor="profileWorkEmailInput"/>
                    <Input id="profileWorkEmailInput" value="{profileEdit>/values/WORK_EMAIL}" enabled="{profileEdit>/states/WORK_EMAIL/EffectiveEditable}" maxLength="241" type="Email" change="onProfileFieldChange"/>

                    <Label text="{i18n>profilePermanentAddress}" labelFor="profilePermanentAddressInput"/>
                    <Input id="profilePermanentAddressInput" value="{profileEdit>/values/ADDRESS}" enabled="{profileEdit>/states/ADDRESS/EffectiveEditable}" maxLength="60" change="onProfileFieldChange"/>

                    <Label text="{i18n>profileCurrentAddress}" labelFor="profileCurrentAddressInput"/>
                    <Input id="profileCurrentAddressInput" value="{profileEdit>/values/CURR_ADDRESS}" enabled="{profileEdit>/states/CURR_ADDRESS/EffectiveEditable}" maxLength="60" change="onProfileFieldChange"/>

                    <Label text="{i18n>profileTaxCode}" labelFor="profileTaxCodeInput"/>
                    <Input id="profileTaxCodeInput" value="{profileEdit>/values/TAX_CODE}" enabled="{profileEdit>/states/TAX_CODE/EffectiveEditable}" maxLength="10" type="Text" change="onProfileFieldChange"/>

                    <Label text="{i18n>profilePaymentMethod}" labelFor="profilePaymentMethodSelect"/>
                    <Select id="profilePaymentMethodSelect" selectedKey="{profileEdit>/values/PAY_METHOD}" enabled="{profileEdit>/states/PAY_METHOD/EffectiveEditable}" change="onPaymentMethodChange" forceSelection="false" items="{profileCatalog>/paymentMethods}">
                        <core:Item key="{profileCatalog>Code}" text="{profileCatalog>DisplayText}"/>
                    </Select>

                    <Label visible="{profileEdit>/isBankTransfer}" text="{i18n>profileBankCountry}" labelFor="profileBankCountryInput" required="true"/>
                    <Input visible="{profileEdit>/isBankTransfer}" id="profileBankCountryInput" value="{profileEdit>/values/BANK_COUNTRY}" enabled="{profileEdit>/states/BANK_COUNTRY/EffectiveEditable}" maxLength="3" change="onProfileFieldChange"/>

                    <Label visible="{profileEdit>/isBankTransfer}" text="{i18n>profileBankKey}" labelFor="profileBankKeyInput" required="true"/>
                    <Input visible="{profileEdit>/isBankTransfer}" id="profileBankKeyInput" value="{profileEdit>/values/BANK_KEY}" enabled="{profileEdit>/states/BANK_KEY/EffectiveEditable}" maxLength="15" change="onProfileFieldChange"/>

                    <Label visible="{profileEdit>/isBankTransfer}" text="{i18n>profileBankAccount}" labelFor="profileBankAccountInput" required="true"/>
                    <Input visible="{profileEdit>/isBankTransfer}" id="profileBankAccountInput" value="{profileEdit>/values/BANK_ACCT}" enabled="{profileEdit>/states/BANK_ACCT/EffectiveEditable}" maxLength="18" type="Text" change="onProfileFieldChange"/>

                </form:SimpleForm>
            </VBox>
        </content>
        <beginButton>
            <Button
                text="{i18n>profileApplyPreviewButton}"
                type="Emphasized"
                icon="sap-icon://accept"
                enabled="{= !${profileEdit>/busy} }"
                press="onSubmitProfileEdit"/>
        </beginButton>
        <endButton>
            <Button text="{i18n>btnCancel}" enabled="{= !${profileEdit>/busy} }" press="onCancelProfileEdit"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
