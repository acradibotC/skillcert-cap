     "items": {
      "type": "ZUI_NXR_SKILLREQ_O4.SAP__Message",
      "notNull": true
     }
    }
   },
   "actions": {
    "approveRequest": {
     "kind": "action",
     "params": {},
     "returns": {
      "type": "ZUI_NXR_SKILLREQ_O4.Request",
      "notNull": true
     },
     "@Core.OperationAvailable": {
      "=": "_it/__OperationControl/approveRequest"
     }
    },
    "rejectRequest": {
     "kind": "action",
     "params": {
      "RejectionReason": {
       "type": "cds.String",
       "length": 255,
       "notNull": true,
       "@Common.Label": "Rejection Reason"
      }
     },
     "returns": {
      "type": "ZUI_NXR_SKILLREQ_O4.Request",
      "notNull": true
     },
     "@Core.OperationAvailable": {
      "=": "_it/__OperationControl/rejectRequest"
     }
    }
   },
   "@Common.Label": "Projection View for Skill Requests",
   "@Common.Messages": {
    "=": "SAP__Messages"
   },
   "@Capabilities.SearchRestrictions.Searchable": false,
   "@Capabilities.FilterRestrictions.NonFilterableProperties": [
    "__EntityControl",
    "__OperationControl"
   ],
