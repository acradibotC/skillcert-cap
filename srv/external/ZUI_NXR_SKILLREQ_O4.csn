  "ZUI_NXR_SKILLREQ_O4.Request": {
   "kind": "entity",
   "@cds.external": true,
   "@cds.persistence.skip": true,
   "elements": {
    "RequestId": {
     "key": true,
     "type": "cds.UUID",
     "notNull": true,
     "@Core.Computed": true,
     "@Common.Label": "UUID",
     "@Common.QuickInfo": "16 Byte UUID in 16 Bytes (Raw Format)"
    },
    "Pernr": {
     "type": "cds.String",
     "length": 8,
     "notNull": true,
     "@Common.IsDigitSequence": true
    },
    "ReqType": {
     "type": "cds.String",
     "length": 10,
     "notNull": true
    },
    "CertName": {
     "type": "cds.String",
     "length": 100,
     "notNull": true
    },
    "QualiId": {
     "type": "cds.String",
     "length": 8,
     "notNull": true
    },
    "QualName": {
     "type": "cds.String",
     "length": 50,
     "notNull": true
    },
    "Source": {
     "type": "cds.String",
     "length": 50,
     "notNull": true
    },
