     "type": "cds.String",
     "length": 50,
     "notNull": true
    },
    "YearsExp": {
     "type": "cds.Integer",
     "@odata.Type": "Edm.Byte",
     "notNull": true
    },
    "Status": {
     "type": "cds.String",
     "length": 2,
     "notNull": true,
     "@Core.Computed": true
    },
    "StatusText": {
     "type": "cds.String",
     "length": 20,
     "notNull": true,
     "@Core.Computed": true
    },
    "RejectionReason": {
     "type": "cds.String",
     "length": 255,
     "notNull": true
    },
    "CreatedBy": {
     "type": "cds.String",
     "length": 12,
     "notNull": true,
     "@Core.Computed": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "User Name",
     "@Common.Heading": "User"
    },
    "CreatedAt": {
     "type": "cds.Timestamp",
     "@odata.Precision": 7,
     "@odata.Type": "Edm.DateTimeOffset",
     "@Core.Computed": true,
     "@Common.Label": "Time Stamp",
     "@Common.QuickInfo": "UTC Time Stamp in Long Form (YYYYMMDDhhmmssmmmuuun)"
    },
    "LastChangedBy": {
     "type": "cds.String",
     "length": 12,
     "notNull": true,
     "@Core.Computed": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "User Name",
     "@Common.Heading": "User"
    },
    "LastChangedAt": {
     "type": "cds.Timestamp",
     "@odata.Precision": 7,
     "@odata.Type": "Edm.DateTimeOffset",
     "@Core.Computed": true,
     "@Common.Label": "Time Stamp",
     "@Common.QuickInfo": "UTC Time Stamp in Long Form (YYYYMMDDhhmmssmmmuuun)"
    },
    "LocalLastChangedAt": {
     "type": "cds.Timestamp",
     "@odata.Precision": 7,
     "@odata.Type": "Edm.DateTimeOffset",
     "@Core.Computed": true,
     "@Common.Label": "Time Stamp",
     "@Common.QuickInfo": "UTC Time Stamp in Long Form (YYYYMMDDhhmmssmmmuuun)"
    },
    "__EntityControl": {
     "type": "ZUI_NXR_SKILLREQ_O4.EntityControl",
     "@Core.Computed": true,
     "@UI.HiddenFilter": true,
     "@UI.Hidden": true
    },
    "__OperationControl": {
     "type": "ZUI_NXR_SKILLREQ_O4.RequestOperationControl",
     "@Core.Computed": true,
     "@UI.HiddenFilter": true,
     "@UI.Hidden": true
    },
