# Authentication and session
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=

# SAP technical connection (use a secret store in deployed environments)
UI5_USERNAME=
UI5_PASSWORD=
ALLOW_INSECURE_SAP_TLS=false

# MyProfile
# mock is permitted only outside production; production fails closed.
PROFILE_MODE=mock
# Optional manual override. Normal HR approver access is derived from HR_ORG_UNIT_IDS.
PROFILE_HR_EMAILS=
# Comma-separated SAP Organizational Management unit IDs treated as HR department users.
HR_ORG_UNIT_IDS=50009040
# disabled keeps local-only workflow; sap stages submitted requests and HR decisions in ZUI_NXR_PROFILE_APPLY_O4.
PROFILE_APPLY_MODE=disabled
PROFILE_APPLY_SERVICE=ZUI_NXR_PROFILE_APPLY_O4
# Default SAP staging mode creates a Pending entity row at submit and updates it when HR decides.
PROFILE_APPLY_STRATEGY=create
PROFILE_APPLY_ENTITY_PATH=/ProfileApplyRequest
PROFILE_APPLY_UPDATE_METHOD=MERGE
# auto uses manual CSRF/cookie handling for SAP Gateway OData V2; set cap only for legacy tests.
PROFILE_APPLY_HTTP_CLIENT=auto
# Optional legacy override when the SAP action path differs from the CAP external action contract.
PROFILE_APPLY_ACTION_PATH=
# MyProfile display reads from the dedicated SAP display service first and can
# fall back to the legacy SkillReq.UserProfile projection while the new service
# is not activated/published yet.
PROFILE_DISPLAY_SERVICE=ZUI_NXR_PROFILE_O4
PROFILE_DISPLAY_FALLBACK_SERVICE=ZUI_NXR_SKILLREQ_O4
PROFILE_DISPLAY_ALLOW_FALLBACK=true
