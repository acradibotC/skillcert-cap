# Authentication and session
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=

# SAP technical connection (use a secret store in deployed environments)
UI5_USERNAME=
UI5_PASSWORD=
ALLOW_INSECURE_SAP_TLS=false

# MyProfile
# mock is permitted only outside production; production fails closed.
PROFILE_MODE=mock
PROFILE_HR_EMAILS=
